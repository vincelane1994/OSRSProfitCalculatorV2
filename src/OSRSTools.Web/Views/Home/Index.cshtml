@model OSRSTools.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h4 class="mb-4">Dashboard</h4>

<div class="row">
    <!-- High Alching Summary — Carousel -->
    <div class="col-lg-3 col-md-6">
        <div class="dashboard-card carousel-card">
            <h5><i class="bi bi-magic me-2"></i>High Alching</h5>
            @if (Model.TopHighAlchItems.Any())
            {
                <div class="carousel-container">
                    <button class="carousel-arrow carousel-prev" id="alchPrev" title="Previous item">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <div class="carousel-content">
                        <div class="stat-value profit-positive" id="alchItemName">--</div>
                        <div class="stat-label" id="alchItemProfit">--</div>
                        <div class="stat-label" id="alchItemRoi">--</div>
                    </div>
                    <button class="carousel-arrow carousel-next" id="alchNext" title="Next item">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
                <div class="carousel-dots" id="alchDots"></div>
            }
            else
            {
                <div class="stat-value">--</div>
                <div class="stat-label">Top profit/cast</div>
            }
        </div>
    </div>

    <!-- Flipping Summary — Carousel -->
    <div class="col-lg-3 col-md-6">
        <div class="dashboard-card carousel-card">
            <h5><i class="bi bi-arrow-left-right me-2"></i>Flipping</h5>
            @if (Model.TopFlipItems.Any())
            {
                <div class="carousel-container">
                    <button class="carousel-arrow carousel-prev" id="flipPrev" title="Previous item">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <div class="carousel-content">
                        <div class="stat-value profit-positive" id="flipItemName">--</div>
                        <div class="stat-label" id="flipItemGpHr">--</div>
                        <div class="stat-label" id="flipItemRoi">--</div>
                    </div>
                    <button class="carousel-arrow carousel-next" id="flipNext" title="Next item">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
                <div class="carousel-dots" id="flipDots"></div>
            }
            else
            {
                <div class="stat-value">--</div>
                <div class="stat-label">Top GP/hr</div>
            }
        </div>
    </div>

    <!-- Smithing Summary — Carousel -->
    <div class="col-lg-3 col-md-6">
        <div class="dashboard-card carousel-card">
            <h5><i class="bi bi-hammer me-2"></i>Smithing</h5>
            @if (Model.TopSmithingItems.Any())
            {
                <div class="carousel-container">
                    <button class="carousel-arrow carousel-prev" id="smithPrev" title="Previous item">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <div class="carousel-content">
                        <div class="stat-value profit-positive" id="smithItemName">--</div>
                        <div class="stat-label" id="smithItemProfit">--</div>
                        <div class="stat-label" id="smithItemRoi">--</div>
                    </div>
                    <button class="carousel-arrow carousel-next" id="smithNext" title="Next item">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
                <div class="carousel-dots" id="smithDots"></div>
            }
            else
            {
                <div class="stat-value">--</div>
                <div class="stat-label">Best profit/bar</div>
            }
        </div>
    </div>

    <!-- Herblore Summary — Carousel -->
    <div class="col-lg-3 col-md-6">
        <div class="dashboard-card carousel-card">
            <h5><i class="bi bi-flower1 me-2"></i>Herblore</h5>
            @if (Model.TopHerbloreItems.Any())
            {
                <div class="carousel-container">
                    <button class="carousel-arrow carousel-prev" id="herbPrev" title="Previous item">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <div class="carousel-content">
                        <div class="stat-value profit-positive" id="herbItemName">--</div>
                        <div class="stat-label" id="herbItemProfit">--</div>
                        <div class="stat-label" id="herbItemMethod">--</div>
                    </div>
                    <button class="carousel-arrow carousel-next" id="herbNext" title="Next item">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
                <div class="carousel-dots" id="herbDots"></div>
            }
            else
            {
                <div class="stat-value">--</div>
                <div class="stat-label">Best profit/herb</div>
            }
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="dashboard-card">
            <h5><i class="bi bi-info-circle me-2"></i>Getting Started</h5>
            <p class="text-secondary mb-0">
                Welcome to OSRS Profit Calculator V2. Select a calculator from the sidebar to explore profitable items.
                Data is synced from the OSRS Wiki Real-Time Prices API.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @if (Model.TopHighAlchItems.Any())
        {
            <text>var topAlchItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopHighAlchItems, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));</text>
        }
        else
        {
            <text>var topAlchItems = [];</text>
        }
        @if (Model.TopFlipItems.Any())
        {
            <text>var topFlipItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopFlipItems, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));</text>
        }
        else
        {
            <text>var topFlipItems = [];</text>
        }
        @if (Model.TopSmithingItems.Any())
        {
            <text>var topSmithingItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopSmithingItems, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));</text>
        }
        else
        {
            <text>var topSmithingItems = [];</text>
        }
        @if (Model.TopHerbloreItems.Any())
        {
            <text>var topHerbloreItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopHerbloreItems, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));</text>
        }
        else
        {
            <text>var topHerbloreItems = [];</text>
        }
    </script>
    <script src="~/js/dashboard.js"></script>
}
