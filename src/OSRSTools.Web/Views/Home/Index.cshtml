@model OSRSTools.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h4 class="mb-4">Dashboard</h4>

<div class="row">
    <!-- High Alching Mini-Table -->
    <div class="col-lg-3 col-md-6">
        <div class="card mb-3" style="background-color:var(--card-bg);border-color:var(--card-border);">
            <div class="card-header d-flex justify-content-between" style="background-color:var(--header-bg);border-color:var(--card-border);color:var(--accent);">
                <span><i class="bi bi-magic me-1"></i> Top High Alch</span>
                <a asp-controller="HighAlching" asp-action="Index" class="small" style="color:var(--text-secondary);">View all &rarr;</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0" id="topAlchTable" style="color:var(--text-primary);">
                    <thead><tr style="background-color:var(--header-bg);color:var(--text-secondary);font-size:0.8rem;">
                        <th style="border-color:var(--card-border);padding:6px 8px;">Item</th>
                        <th style="border-color:var(--card-border);padding:6px 8px;">Profit</th>
                        <th style="border-color:var(--card-border);padding:6px 8px;">ROI%</th>
                    </tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Flipping Mini-Table -->
    <div class="col-lg-3 col-md-6">
        <div class="card mb-3" style="background-color:var(--card-bg);border-color:var(--card-border);">
            <div class="card-header d-flex justify-content-between" style="background-color:var(--header-bg);border-color:var(--card-border);color:var(--accent);">
                <span><i class="bi bi-arrow-left-right me-1"></i> Top Flips</span>
                <a asp-controller="Flipping" asp-action="Index" class="small" style="color:var(--text-secondary);">View all &rarr;</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0" id="topFlipsTable" style="color:var(--text-primary);">
                    <thead><tr style="background-color:var(--header-bg);color:var(--text-secondary);font-size:0.8rem;">
                        <th style="border-color:var(--card-border);padding:6px 8px;">Item</th>
                        <th style="border-color:var(--card-border);padding:6px 8px;">GP/hr</th>
                        <th style="border-color:var(--card-border);padding:6px 8px;">ROI%</th>
                    </tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Smithing Mini-Table -->
    <div class="col-lg-3 col-md-6">
        <div class="card mb-3" style="background-color:var(--card-bg);border-color:var(--card-border);">
            <div class="card-header d-flex justify-content-between" style="background-color:var(--header-bg);border-color:var(--card-border);color:var(--accent);">
                <span><i class="bi bi-hammer me-1"></i> Top Smithing</span>
                <a asp-controller="Smithing" asp-action="Index" class="small" style="color:var(--text-secondary);">View all &rarr;</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0" id="topSmithingTable" style="color:var(--text-primary);">
                    <thead><tr style="background-color:var(--header-bg);color:var(--text-secondary);font-size:0.8rem;">
                        <th style="border-color:var(--card-border);padding:6px 8px;">Item</th>
                        <th style="border-color:var(--card-border);padding:6px 8px;">Profit/Bar</th>
                        <th style="border-color:var(--card-border);padding:6px 8px;">ROI%</th>
                    </tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Herblore Mini-Table -->
    <div class="col-lg-3 col-md-6">
        <div class="card mb-3" style="background-color:var(--card-bg);border-color:var(--card-border);">
            <div class="card-header d-flex justify-content-between" style="background-color:var(--header-bg);border-color:var(--card-border);color:var(--accent);">
                <span><i class="bi bi-flower1 me-1"></i> Top Herblore</span>
                <a asp-controller="Herblore" asp-action="Index" class="small" style="color:var(--text-secondary);">View all &rarr;</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0" id="topHerbloreTable" style="color:var(--text-primary);">
                    <thead><tr style="background-color:var(--header-bg);color:var(--text-secondary);font-size:0.8rem;">
                        <th style="border-color:var(--card-border);padding:6px 8px;">Item</th>
                        <th style="border-color:var(--card-border);padding:6px 8px;">Profit</th>
                        <th style="border-color:var(--card-border);padding:6px 8px;">Method</th>
                    </tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="dashboard-card">
            <h5><i class="bi bi-info-circle me-2"></i>Getting Started</h5>
            <p class="text-secondary mb-0">
                Welcome to OSRS Profit Calculator V2. Select a calculator from the sidebar to explore profitable items.
                Data is synced from the OSRS Wiki Real-Time Prices API.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @if (Model.TopHighAlchItems.Any())
        {
            <text>var topAlchItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopHighAlchItems, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));</text>
        }
        else
        {
            <text>var topAlchItems = [];</text>
        }
        @if (Model.TopFlipItems.Any())
        {
            <text>var topFlipItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopFlipItems, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));</text>
        }
        else
        {
            <text>var topFlipItems = [];</text>
        }
        @if (Model.TopSmithingItems.Any())
        {
            <text>var topSmithingItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopSmithingItems, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));</text>
        }
        else
        {
            <text>var topSmithingItems = [];</text>
        }
        @if (Model.TopHerbloreItems.Any())
        {
            <text>var topHerbloreItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopHerbloreItems, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));</text>
        }
        else
        {
            <text>var topHerbloreItems = [];</text>
        }
    </script>
    <script src="~/js/dashboard.js"></script>
}
