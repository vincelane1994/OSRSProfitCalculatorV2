{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OsrsApi": {
    "BaseUrl": "https://prices.runescape.wiki/api/v1/osrs/",
    "UserAgent": "OSRSProfitCalculatorV2/1.0 - Personal Use",
    "Endpoints": {
      "Mapping": "mapping",
      "Latest": "latest",
      "FiveMinute": "5m",
      "OneHour": "1h",
      "SixHour": "6h",
      "TwentyFourHour": "24h"
    }
  },
  "Tax": {
    "Rate": 0.02,
    "Cap": 5000000
  },
  "Cache": {
    "MappingDuration": "24:00:00",
    "PriceDuration": "00:05:00"
  },
  "PriceWeights": {
    "FiveMinute": 0.50,
    "OneHour": 0.30,
    "SixHour": 0.15,
    "TwentyFourHour": 0.05
  },
  "Scoring": {
    "VolumeBreakpoints": [
      { "Threshold": 1000, "Score": 0.1 },
      { "Threshold": 10000, "Score": 0.3 },
      { "Threshold": 50000, "Score": 0.6 },
      { "Threshold": 200000, "Score": 1.0 }
    ],
    "TotalProfitBreakpoints": [
      { "Threshold": 10000, "Score": 0.1 },
      { "Threshold": 50000, "Score": 0.3 },
      { "Threshold": 200000, "Score": 0.6 },
      { "Threshold": 500000, "Score": 0.8 },
      { "Threshold": 2000000, "Score": 1.0 }
    ],
    "RoiBreakpoints": [
      { "Threshold": 0.0, "Score": 0.0 },
      { "Threshold": 1.0, "Score": 0.05 },
      { "Threshold": 3.0, "Score": 0.30 },
      { "Threshold": 5.0, "Score": 0.60 },
      { "Threshold": 10.0, "Score": 0.85 },
      { "Threshold": 20.0, "Score": 1.0 }
    ],
    "VolumeWeight": 0.20,
    "TotalProfitWeight": 0.35,
    "RoiWeight": 0.20,
    "GpPerHourWeight": 0.25,
    "MinWindowsForHighConfidence": 3,
    "MinVolumeForHighConfidence": 50000
  },
  "ManipulationDetection": {
    "PriceDeviationThresholdPercent": 25.0,
    "VolumeRatioThreshold": 10.0,
    "HighRoiThresholdPercent": 8.0,
    "LowVolumeThreshold": 5000
  }
}
